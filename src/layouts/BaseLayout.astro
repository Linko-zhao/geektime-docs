---
import '../styles/site.css';

interface Props {
  title?: string;
}

const { title = '极客时间文档' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="极客时间 Markdown 文档" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@100..900&family=Sora:wght@500..800&display=swap" />
    <title>{title}</title>
    <script is:inline>
      const storedTheme = localStorage.getItem('theme');
      if (storedTheme === 'dark' || (!storedTheme && matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">极客时间文档</a>
      <span>技术课程 Markdown 阅读站</span>
      <div class="header-actions">
        <slot name="header-actions" />
        <button type="button" class="theme-toggle" data-theme-toggle aria-label="切换深色模式">
          <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/></svg>
          <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>
        </button>
      </div>
    </header>
    <main><slot /></main>
    <button type="button" class="back-to-top" data-back-to-top hidden aria-label="返回顶部">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7" />
      </svg>
    </button>
    <footer>极客时间文档 · 由 Astro 静态生成</footer>
    <script>
      const header = document.querySelector<HTMLElement>('.site-header');
      const backToTop = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
      const brand = document.querySelector<HTMLElement>('.brand');

      if (header && backToTop && brand) {
        let previousScrollY = window.scrollY;
        let direction = 0;
        let accumulatedDistance = 0;
        let animationFrame: number | undefined;

        const setHeaderHidden = (hidden: boolean) => {
          header.toggleAttribute('data-scroll-hidden', hidden);
          document.documentElement.classList.toggle('header-hidden', hidden);
        };

        const updateScrollState = () => {
          const scrollY = window.scrollY;
          backToTop.hidden = scrollY <= 400;

          if (scrollY <= 60) {
            setHeaderHidden(false);
            previousScrollY = scrollY;
            direction = 0;
            accumulatedDistance = 0;
            return;
          }

          const distance = scrollY - previousScrollY;
          previousScrollY = scrollY;
          if (distance === 0) return;

          const nextDirection = distance > 0 ? 1 : -1;
          if (nextDirection !== direction) {
            direction = nextDirection;
            accumulatedDistance = 0;
          }
          accumulatedDistance += Math.abs(distance);

          if (accumulatedDistance >= 8) setHeaderHidden(direction > 0);
        };

        window.addEventListener('scroll', () => {
          if (animationFrame !== undefined) return;
          animationFrame = window.requestAnimationFrame(() => {
            animationFrame = undefined;
            updateScrollState();
          });
        }, { passive: true });

        backToTop.addEventListener('click', () => {
          brand.focus({ preventScroll: true });
          window.scrollTo({
            top: 0,
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });

        updateScrollState();
      }

      const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      themeToggle?.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('theme', dark ? 'dark' : 'light');
        } catch {
          // Toggle still works when storage is unavailable.
        }
      });
    </script>
  </body>
</html>
