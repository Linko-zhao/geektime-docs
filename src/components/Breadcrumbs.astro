---
import { href } from '../lib/content';

interface Props {
  category: string;
  course?: string;
  article?: string;
}

const { category, course, article } = Astro.props;
---

<nav class="breadcrumbs" aria-label="面包屑导航">
  <a href="/">首页</a><span>/</span>
  <a href={href(category)}>{category}</a>
  {course && <><span>/</span><a href={href(category, course)}>{course}</a></>}
  {article && <><span>/</span><span aria-current="page">{article}</span></>}
</nav>
