---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props as { headings: Heading[] };

function titleWithoutNumber(text: string) {
  return text.replace(/^\s*(?:\d+(?:\.\d+)+\s+|\d+[.、．。:：)）]|[一二三四五六七八九十百千万]+[、．。:：)）])\s*/, '');
}
const items = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---

{items.length > 0 && (
  <aside class="toc" aria-label="本页目录">
    <details open>
      <summary>本页目录</summary>
      <ul>
        {items.map((heading) => (
          <li class:list={{ nested: heading.depth === 3 }}>
            <a href={`#${heading.slug}`} data-toc-link>{titleWithoutNumber(heading.text)}</a>
          </li>
        ))}
      </ul>
    </details>
  </aside>
)}

<script>
  document.querySelectorAll<HTMLElement>('.toc').forEach((toc) => {
    const links = [...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
    const headings = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((heading): heading is HTMLElement => heading !== null);

    if (!headings.length) return;

    const observer = new IntersectionObserver(
      (entries) => {
        const active = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
        if (!active) return;
        for (const link of links) link.classList.toggle('active', link.hash === `#${active.target.id}`);
      },
      { rootMargin: '0px 0px -72% 0px' },
    );
    headings.forEach((heading) => observer.observe(heading));
  });
</script>
