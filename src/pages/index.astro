---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, href } from '../lib/content';

type SearchItem = {
  type: 'course' | 'article';
  title: string;
  context: string;
  href: string;
};

interface CourseSummary {
  category: string;
  name: string;
  articleCount: number;
}

// shortcut: 首页索引只走文件名（文件名即文章标题），不加载 Markdown 集合与正文；
// 若以后需要按正文搜索，再引入构建期索引文件
const root = process.cwd();
const courses: CourseSummary[] = [];
const searchItems: SearchItem[] = [];

for (const category of categories) {
  const categoryPath = join(root, category);
  if (!existsSync(categoryPath)) continue;
  for (const item of readdirSync(categoryPath, { withFileTypes: true })) {
    if (!item.isDirectory()) continue;
    const docsPath = join(categoryPath, item.name, 'docs');
    if (!existsSync(docsPath)) continue;
    const files = readdirSync(docsPath).filter((file) => file.toLowerCase().endsWith('.md'));
    courses.push({ category, name: item.name, articleCount: files.length });
    searchItems.push({
      type: 'course',
      title: item.name,
      context: category,
      href: href(category, item.name),
    });
    for (const file of files) {
      const slug = file.replace(/\.md$/i, '').replace(/%/g, 'percent');
      searchItems.push({
        type: 'article',
        title: slug,
        context: `${category} · ${item.name}`,
        href: href(category, item.name, slug),
      });
    }
  }
}
const serializedSearchItems = JSON.stringify(searchItems).replace(/</g, '\\u003c');
---

<BaseLayout>
  <section class="page-intro hero">
    <p class="eyebrow">Markdown 文档库</p>
    <h1>极客时间文档</h1>
    <p>按当前文件夹层级浏览全部技术课程。</p>
  </section>
  <section class="search-panel" aria-label="全站搜索">
    <label for="site-search">搜索课程或文章</label>
    <input id="site-search" type="search" autocomplete="off" placeholder="输入课程名或文章名" data-search-input>
    <div class="search-filters" role="group" aria-label="搜索结果类型">
      <button type="button" data-search-filter="all" aria-pressed="true">全部</button>
      <button type="button" data-search-filter="course" aria-pressed="false">课程</button>
      <button type="button" data-search-filter="article" aria-pressed="false">文章</button>
    </div>
    <section class="search-region" data-search-region hidden>
      <p data-search-status aria-live="polite"></p>
      <ol class="search-results" data-search-results></ol>
      <p class="search-empty" data-search-empty hidden>未找到匹配的课程或文章</p>
    </section>
  </section>
  <section class="category-grid" aria-label="课程分类" data-category-grid>
    {categories.map((category) => {
      const grouped = courses.filter((course) => course.category === category);
      return <a class="category-card" href={href(category)}><h2>{category}</h2><span>{grouped.length} 门课程</span></a>;
    })}
  </section>
  <script id="search-index" type="application/json" is:inline set:html={serializedSearchItems}></script>
  <script>
    type SearchResult = {
      type: 'course' | 'article';
      title: string;
      context: string;
      href: string;
    };

    const searchIndex = document.querySelector<HTMLScriptElement>('#search-index');
    const searchInput = document.querySelector<HTMLInputElement>('[data-search-input]');
    const searchRegion = document.querySelector<HTMLElement>('[data-search-region]');
    const categoryGrid = document.querySelector<HTMLElement>('[data-category-grid]');
    const searchStatus = document.querySelector<HTMLElement>('[data-search-status]');
    const searchResults = document.querySelector<HTMLOListElement>('[data-search-results]');
    const searchEmpty = document.querySelector<HTMLElement>('[data-search-empty]');
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-search-filter]');

    if (searchIndex && searchInput && searchRegion && categoryGrid && searchStatus && searchResults && searchEmpty) {
      type SearchFilter = 'all' | SearchResult['type'];

      const items = JSON.parse(searchIndex.textContent ?? '[]') as SearchResult[];
      const normalize = (value: string) => value.trim().toLocaleLowerCase('zh-CN');
      let activeFilter: SearchFilter = 'all';

      const updateFilterButtons = () => {
        filterButtons.forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.searchFilter === activeFilter));
        });
      };

      const renderResults = () => {
        const query = normalize(searchInput.value);
        searchResults.replaceChildren();

        if (!query) {
          searchStatus.textContent = '';
          searchEmpty.hidden = true;
          searchRegion.hidden = true;
          categoryGrid.hidden = false;
          return;
        }

        const matches = items.filter((item) => (
          (activeFilter === 'all' || item.type === activeFilter) &&
          normalize(item.title).includes(query)
        ));
        searchRegion.hidden = false;
        categoryGrid.hidden = true;
        searchStatus.textContent = `找到 ${matches.length} 个结果`;
        searchEmpty.hidden = matches.length > 0;

        for (const match of matches) {
          const item = document.createElement('li');
          const link = document.createElement('a');
          const type = document.createElement('span');
          const title = document.createElement('span');
          const context = document.createElement('span');

          item.className = 'search-result-item';
          link.className = 'search-result-link';
          link.href = match.href;
          type.className = 'search-result-type';
          type.textContent = match.type === 'course' ? '课程' : '文章';
          title.className = 'search-result-title';
          title.textContent = match.title;
          context.className = 'search-result-context';
          context.textContent = match.context;

          link.append(type, title, context);
          item.append(link);
          searchResults.append(item);
        }
      };

      searchInput.addEventListener('input', renderResults);
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.dataset.searchFilter;
          if (filter !== 'all' && filter !== 'course' && filter !== 'article') return;
          activeFilter = filter;
          updateFilterButtons();
          renderResults();
        });
      });
    }
  </script>
</BaseLayout>
