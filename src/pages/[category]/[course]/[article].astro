---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ArticleSidebar from '../../../components/ArticleSidebar.astro';
import TableOfContents from '../../../components/TableOfContents.astro';
import MobileArticleDrawer from '../../../components/MobileArticleDrawer.astro';
import { getSiteIndex, href, toIndexedArticle } from '../../../lib/content';

export async function getStaticPaths() {
  const courses = await getSiteIndex();
  return courses.flatMap((course) => course.articles.map((entry, order) => {
    const slug = (entry.id.split('/').at(-1) || '').replace(/%/g, 'percent');
    return {
      params: { category: course.category, course: course.name, article: slug },
      props: { course, entry, order },
    };
  }));
}

const { course, entry, order } = Astro.props;
const articles = course.articles.map((item, index) => toIndexedArticle(course.category, course.name, item, index));
const article = articles[order];
const { Content, headings } = await render(entry);
const previous = articles[order - 1];
const next = articles[order + 1];
---

<BaseLayout title={`${article.title} · ${course.name}`}>
  <MobileArticleDrawer slot="header-actions" articles={articles} activeSlug={article.slug} headings={headings} />
  <button slot="header-actions" type="button" class="focus-mode-toggle" data-focus-mode-toggle aria-label="进入专注模式" aria-controls="article-layout" aria-pressed="false">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 7v14" />
      <path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3z" />
      <path d="M21 18a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1h-5a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3z" />
    </svg>
  </button>
  <div id="article-layout" class="article-shell">
    <ArticleSidebar articles={articles} activeSlug={article.slug} />
    <div class="article-main">
      <Breadcrumbs category={course.category} course={course.name} article={article.title} />
      <article class="prose">
        <h1>{article.title}</h1>
        <Content />
      </article>
      <nav class="article-pagination" aria-label="文章翻页">
        {previous ? <a href={href(previous.category, previous.course, previous.slug)}>← {previous.title}</a> : <span />}
        {next && <a href={href(next.category, next.course, next.slug)}>{next.title} →</a>}
      </nav>
    </div>
    <TableOfContents headings={headings} />
  </div>
</BaseLayout>

<script>
  const focusModeToggle = document.querySelector<HTMLButtonElement>('[data-focus-mode-toggle]');
  const articleLayout = document.querySelector<HTMLElement>('#article-layout');

  if (focusModeToggle && articleLayout) {
    const setFocusMode = (focused: boolean, persist = true) => {
      articleLayout.toggleAttribute('data-focus-mode', focused);
      focusModeToggle.setAttribute('aria-pressed', String(focused));
      focusModeToggle.setAttribute('aria-label', focused ? '退出专注模式' : '进入专注模式');

      if (persist) {
        try {
          localStorage.setItem('geektime-docs:focus-mode', String(focused));
        } catch {
          // Focus mode still works when storage is unavailable.
        }
      }
    };

    let storedValue: string | null = null;
    try {
      storedValue = localStorage.getItem('geektime-docs:focus-mode');
    } catch {
      // Missing storage falls back to normal mode.
    }
    setFocusMode(storedValue === 'true', false);

    focusModeToggle.addEventListener('click', () => {
      setFocusMode(!articleLayout.hasAttribute('data-focus-mode'));
    });
  }
</script>
